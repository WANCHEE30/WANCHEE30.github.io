---
import BaseLayout from '../layouts/BaseLayout.astro';

const milestones = [
  { year: '1960', text: '老董事長李曼英先生於 10 月正式成立萬記貿易。' },
  { year: '1964', text: '代理 BONLAC（BUD）奶粉及荷蘭 Coberco 集團白美娜濃縮奶水，創下輝煌銷售業績。' },
  { year: '1966', text: '代理克寧奶粉及桂格系列，打響市場知名度。' },
  { year: '1968', text: '代理綠巨人玉米粒、玉米醬，造成搶購熱潮。' },
  { year: '1981', text: '公司由迪化街遷至民權西路。' },
  { year: '1983', text: '由老董事長之子李惠融總經理接任，將企業發揚光大。' },
  { year: '1989', text: '代理美國月光牌泡打粉，佔台灣九成市場。' },
  { year: '1999', text: '於大陸上海設立食品工廠。' },
  { year: '2000', text: '由民權西路遷至人文薈萃的天母地區。' },
];

const values = [
  { k: '以人為本', v: '以關懷人為出發，以成就人為依歸。' },
  { k: '尊重', v: '自我尊重、敬業樂群，互信互重，真心關懷。' },
  { k: '創新', v: '快速學習，觀念創新，開創新機，精益求精。' },
  { k: '價值', v: '顧客滿意，員工樂意，企業永續，服務社會。' },
];
---
<BaseLayout title="關於萬記 — 萬記貿易有限公司" description="萬記貿易由李曼英先生於 1960 年創立，前身為迪化街惠融行。半世紀深耕食品原料，以「以人為本：尊重、創新、價值」為經營理念。">
  <section class="page-hero">
    <div class="wrap">
      <span class="hero-badge">ABOUT WANCHEE</span>
      <h1>關於萬記</h1>
      <p>每個企業都有自己的根。半世紀深耕食品業，以誠信殷實的創業精神，為烘焙與食品加工提供安全、穩定的優質原料。</p>
    </div>
  </section>

  <!-- 公司願景 -->
  <section>
    <div class="wrap prose">
      <span class="eyebrow">OUR VISION</span>
      <h2 class="title">企業願景</h2>
      <p>在 50 年的歲月流轉中，萬記得以從競爭激烈、市場汰換迅速的環境中安然渡過經濟風暴，因應的是謹記先人從大陸落腳迪化街、深耕食品業，誠信、殷實的創業精神。在一步一腳印踏實耕耘後，客戶的忠誠度和信賴度鼓勵我們繼續堅持，以提供優質產品、創造優質的健康生活為萬記的企業願景。</p>
      <p>半世紀以來專精的經營理念，讓萬記累積了豐碩的市場經驗與信譽，同時奠定了自創品牌國際化的基石。因應全球經濟模式的改變與國際產業分工，2000 年萬記以台灣的成功優勢，多方尋求國際優質原料來源及高科技的轉移合作，在上海設立科技化的食品工廠；並在大連、寧夏等清靜無污染的乳源地，技術轉移合作研發出更符合消費者利益與健康的優質產品。</p>
      <p>2006 年起的下半世紀，萬記的經營團隊更將擴大營業面積和型態，積極推展出口業務，以多年的行銷信心掌握全新的經營策略，再造自創品牌全球化的企業目標，建構萬記公司國際化的企業藍圖。</p>
    </div>
  </section>

  <!-- 創立歷史 / 企業沿革 -->
  <section class="products">
    <div class="wrap">
      <span class="eyebrow">OUR ROOTS</span>
      <h2 class="title">創立歷史與企業沿革</h2>
      <div class="two-col">
        <div class="block">
          <h3>創立歷史</h3>
          <p>台北迪化街是台灣最古老也最具特色的商業街市，曾陪大家一起成長茁壯。走過台灣的歲月，經歷不同時代的焠鍊與洗禮，迪化街自成一套相沿成習、約定俗成，且經得起千錘百鍊的交易習慣與市場秩序，因而孕育出許多在台灣各行各業舉足輕重的企業菁英。萬記貿易即是在這種環境之下，由老董事長李曼英先生一手創立，至今已在食品業界扮演舉足輕重的角色。</p>
        </div>
        <div class="block">
          <h3>企業沿革</h3>
          <p>萬記貿易的前身即是「惠融行」，位於迪化街，專營南北貨以及進口食品罐頭，頗受好評。從南北貨起家，到代理國際知名奶粉、泡打粉與濃縮鮮乳，萬記一路見證並參與了台灣食品產業的發展。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 重要事紀 -->
  <section>
    <div class="wrap">
      <span class="eyebrow">MILESTONES</span>
      <h2 class="title">重要事紀</h2>
      <div class="timeline" style="margin-top:36px">
        {milestones.map((m) => <div><b>{m.year}</b>{m.text}</div>)}
      </div>
    </div>
  </section>

  <!-- 企業使命及經營理念 -->
  <section class="products">
    <div class="wrap">
      <span class="eyebrow">OUR PHILOSOPHY</span>
      <h2 class="title">企業使命及經營理念</h2>
      <p class="lead">經營理念 ——「以人為本：尊重、創新、價值」</p>
      <div class="value-grid">
        {values.map((v) => (
          <div class="value-card"><b>{v.k}</b><span>{v.v}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 經營方向 / 企業展望 -->
  <section>
    <div class="wrap prose">
      <span class="eyebrow">LOOKING AHEAD</span>
      <h2 class="title">經營方向與企業展望</h2>
      <p>在邁向現代化的過程中，萬記深信：在科技不斷發展、資訊不斷躍昇的二十一世紀，唯有隨著時代脈動一起發揮企業實力，才能成為國際知名的領導品牌——所以我們和全球同步、與世界接軌，堅持品質！</p>
      <p>永遠創新、永遠領先是萬記貿易不變的理念。不論在對社會的貢獻上，都展現了大企業的宏觀態度，所做的每件事也都對大眾真心付出、奉獻關懷。如此努力不懈的原因，是因為萬記相信：超越自己就是成功——這是萬記自民國 49 年成立以來始終如一的堅持，也是我們對消費者永遠的承諾。</p>
      <p>未來我們將繼續朝經銷專業化、管理國際化努力，並致力海外市場的開拓，如大陸、日本、澳洲等，建立完整的銷售網，將萬記產品送達世界每一個角落，為全人類的健康貢獻心力，再創萬記貿易的高峰！</p>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2 class="title">想了解更多產品？</h2>
      <a href="/products" class="btn btn-light" style="background:var(--red);color:#fff">瀏覽產品系列</a>
    </div>
  </section>
</BaseLayout>
